<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iimscollege.edu.np.campusspaceandresourcebookingsystem.AdminDashboardController">
    <Label text="Admin Management"><font><Font name="System Bold" size="20.0" /></font></Label>
    <TableView fx:id="bookingTable" prefHeight="250.0">
        <columns>
            <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="colUser" prefWidth="100.0" text="User" />
            <TableColumn fx:id="colResId" prefWidth="100.0" text="Resource" />
            <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            <TableColumn fx:id="colActions" prefWidth="200.0" text="Actions" />
        </columns>
    </TableView>
    <Label text="System Audit Logs"><font><Font name="System Bold" size="14.0" /></font></Label>
    <ListView fx:id="logListView" prefHeight="150.0" VBox.vgrow="ALWAYS" />
</VBox>