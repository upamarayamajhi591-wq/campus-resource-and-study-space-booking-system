<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-padding: 24;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="iimscollege.edu.np.campusspaceandresourcebookingsystem.AvailableResourcesController">
    <Label text="Available Resources"><font><Font name="System Bold" size="20.0" /></font></Label>
    <TableView fx:id="resourceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="180.0" text="Resource Name" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colLocation" prefWidth="180.0" text="Location" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            <TableColumn fx:id="colAction" prefWidth="120.0" text="Action" />
        </columns>
    </TableView>
</VBox>